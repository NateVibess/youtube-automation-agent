  ],
  "cta_sentence": 6,
  "sentences": [
   {
    "text": "Minecraft is now on Roblox, and you can raise your own dragon.",
    "clips": [
     {
      "id": "73648165ef2b",
      "at": 0.3
     },
     {
      "id": "16e12caa3938",
      "at": 2.5,
      "flash": true
     }
    ]
   },
   {
    "text": "This is Minerscave.",
    "clips": [
     {
      "id": "91a071527bb3",
      "at": 0.3,
      "bw": true
     }
    ]
   },
   {
    "text": "Find a dragon nest and steal the egg while the mother sleeps.",
    "clips": [
     {
      "id": "aebd06c36408",
      "at": 0.3
     },
     {
      "id": "73648165ef2b",
      "at": 6.0
     }
    ]
   },
   {
    "text": "Heat it on lava, hatch it, and feed your baby dragon.",
    "clips": [
     {
      "id": "48d5bbaeeafe",
      "at": 3.0
     },
     {
      "id": "16e12caa3938",
      "at": 1.0
     },
     {
      "id": "7da5a71de1ea",
      "at": 0.5
     }
    ]
   },
   {
    "text": "It grows up, and then you ride it.",
    "clips": [
     {
      "id": "a720e430552c",
      "at": 1.2
     },
     {
      "id": "6540de93fcae",
      "at": 1.0
     }
    ]
   },
   {
    "text": "Fly through rings, hit targets with fireballs, and soar over the whole world.",
    "clips": [
     {
      "id": "72e90b9c8b18",
      "at": 9.0
     },
     {
      "id": "37cf15f89cb0",
      "at": 1.5
     },
     {
      "id": "30cc7b10d1f1",
      "at": 4.0
     }
    ]
   },
   {
    "text": "Minerscave is free on Roblox right now.",
    "clips": [
     {
      "id": "d9fe1ceedbef",
      "at": 3.0
     }
    ]
   },
   {
    "text": "Use code CREATOR for a free starter kit. Go play it.",
    "clips": [
     {
      "id": "926ff7cd2b88",
      "at": 2.0
     }
    ]
   }
  ],
